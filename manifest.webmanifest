{
  "name": "极光音乐 Aurora Music",
  "short_name": "极光音乐",
  "description": "本地优先的极简音乐播放器，支持录音自动配图与自由许可音源下载",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#07070c",
  "theme_color": "#07070c",
  "lang": "zh-CN",
  "dir": "ltr",
  "categories": ["music", "entertainment", "utilities"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "开始录音",
      "short_name": "录音",
      "description": "直接进入录音页",
      "url": "./index.html#record",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "我的曲库",
      "short_name": "曲库",
      "description": "查看本地全部音频",
      "url": "./index.html#library",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}